<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Second pass of the 027 gallery back-fill.

      027-backfill-product-images seeded product_images from the legacy single cover, but a Liquibase
      changeSet runs exactly once — any product that arrived AFTER that execution and did not go
      through ProductService.applyMedia (bulk imports, the ops/migrate-vendor.py storefront copy from
      a source that was itself missing the rows) still has product_image_url set and no gallery rows.
      Those products render as a single image with no thumbnail strip.

      Unlike 027 this is guarded by NOT EXISTS, so it only touches products with an empty gallery and
      is safe to run against any environment.
    -->
    <changeSet id="038-backfill-missing-product-images" author="babajide">
        <sql>
            INSERT INTO product_images (product_id, position, url)
            SELECT p.id, 0, p.product_image_url
            FROM products p
            WHERE p.product_image_url IS NOT NULL AND p.product_image_url &lt;&gt; ''
              AND NOT EXISTS (SELECT 1 FROM product_images pi WHERE pi.product_id = p.id)
        </sql>
        <rollback>
            <!-- Only the covers this changeSet could have written: single-row galleries that still
                 match the product's denormalized cover. Multi-image galleries are left alone. -->
            <sql>
                DELETE FROM product_images pi
                WHERE pi.position = 0
                  AND EXISTS (SELECT 1 FROM products p WHERE p.id = pi.product_id AND p.product_image_url = pi.url)
                  AND (SELECT COUNT(*) FROM product_images x WHERE x.product_id = pi.product_id) = 1
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>