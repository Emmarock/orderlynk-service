<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Per-option stock. A product may now sell specific colour/size combinations, each holding its
      own quantity, so one option selling out doesn't take the whole product down.

      Opt-in: existing products have no rows here and keep using products.quantity_available as
      before. When a product does have options, quantity_available is maintained as their sum, which
      keeps every existing storefront/low-stock/sold-out read working unchanged.
    -->
    <changeSet id="039-create-product-variants" author="babajide">
        <createTable tableName="product_variants">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
            <!-- Either may be null: a product can vary by colour only, or by size only. -->
            <column name="color" type="VARCHAR(64)"/>
            <column name="size" type="VARCHAR(64)"/>
            <column name="quantity_available" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="product_variants" indexName="idx_product_variants_product">
            <column name="product_id"/>
        </createIndex>
        <sql>ALTER TABLE product_variants ADD CONSTRAINT chk_product_variant_qty CHECK (quantity_available >= 0)</sql>
    </changeSet>

    <!-- Which option an order line was for. Null on lines placed before options existed, and on
         simple products that have none. -->
    <changeSet id="039-add-variant-id-to-order-items" author="babajide">
        <addColumn tableName="order_items">
            <column name="variant_id" type="VARCHAR(36)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>